# CATATAN: environment production & kredensial database TIDAK LAGI
# bergantung pada SetEnv di sini -- sempat menyebabkan aplikasi gagal
# konek database karena SetEnv tidak selalu diteruskan ke PHP tergantung
# cara hosting menjalankan PHP (PHP-FPM/LiteSpeed vs mod_php klasik).
#
# - Environment production: index.php sekarang mendeteksi otomatis
#   (lihat define('ENVIRONMENT', ...) di index.php) -- tidak perlu SetEnv.
# - Kredensial database & encryption key: isi langsung di server lewat
#   application/config/production/database.php dan config.php (disalin
#   dari file *.php.example di folder yang sama, HANYA di server, jangan
#   pernah di-commit).
#
# Baris SetEnv di bawah ini aman dibiarkan sebagai cadangan kedua bila
# hosting Anda kebetulan mendukungnya, tapi JANGAN diandalkan sebagai
# satu-satunya cara.
<IfModule mod_env.c>
  SetEnv CI_ENV production
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine on
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>