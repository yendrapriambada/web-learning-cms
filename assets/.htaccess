# Folder ini (dan seluruh sub-folder, termasuk assets/uploads/, assets/soal/,
# assets/jawaban_gambar/, assets/jawaban_file/, assets/sumber_belajar/) hanya
# untuk menyimpan file yang diunggah pengguna. Cegah file yang diunggah
# dieksekusi sebagai skrip PHP (lihat Vulnerability Assessment, Temuan #8).

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pht)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
